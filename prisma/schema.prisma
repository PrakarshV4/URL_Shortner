generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model urls {
  id           Int       @id @default(autoincrement())
  short_code   String    @unique @db.VarChar(20)
  original_url String
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}
